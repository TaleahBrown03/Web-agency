---
// Hero.astro - Premium hero with asymmetric layout
import { PHONE_DISPLAY, PHONE_HREF, PRICING_TIERS } from '../data/pricing';
---

<section class="relative overflow-hidden py-24 sm:py-40">
  <!-- Ambient background -->
  <div class="absolute -top-96 right-0 h-96 w-96 rounded-full bg-mint-500/10 blur-3xl" aria-hidden="true"></div>

  <div class="relative mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="space-y-10 text-center lg:space-y-12">
      <!-- Badge -->
      <div class="inline-block rounded-full border border-mint-500/30 bg-slate-900/40 px-4 py-2">
        <span class="text-sm font-semibold text-mint-300">Web design for Orange County, NY businesses</span>
      </div>

      <!-- Main Headline -->
      <h1 class="animate-slide-up mx-auto max-w-5xl text-5xl font-bold tracking-tight text-slate-50 sm:text-6xl lg:text-7xl">
        Websites Built to Get Your Business Found and Get You Calls
      </h1>

      <!-- Sub-headline: Software Engineering Advantage -->
      <p class="animate-slide-up mx-auto max-w-3xl text-xl font-medium text-slate-300 delay-100 sm:text-2xl">
        We design and build fast, custom-coded websites for local businesses in Middletown, Newburgh, Warwick, and across Orange County, NY — built around what you want, no templates.
      </p>

      <!-- Supporting statement -->
      <p class="animate-fade-in mx-auto max-w-2xl text-lg text-slate-400 delay-200">
        Three clear packages, from {PRICING_TIERS[0].startsAt}, all one-time fees. Optional monthly care plan for hosting and updates.
      </p>

      <!-- Dual CTA Buttons -->
      <div class="animate-fade-in flex flex-col gap-4 sm:flex-row sm:justify-center delay-300">
        <a
          href="/contact"
          class="group inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-mint-500 to-teal-500 px-8 py-4 text-lg font-bold text-slate-950 shadow-2xl shadow-mint-500/30 transition hover:shadow-mint-500/50 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-mint-400 focus:ring-offset-2 focus:ring-offset-slate-950 active:scale-95"
        >
          <svg class="h-6 w-6 transition group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>
          Book Free Consultation
        </a>
        <a
          href={PHONE_HREF}
          class="group inline-flex items-center justify-center gap-2 rounded-xl border-2 border-mint-500/60 bg-slate-900/40 px-8 py-4 text-lg font-bold text-slate-100 transition hover:border-mint-400 hover:bg-slate-800/60 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-mint-400/50 focus:ring-offset-2 focus:ring-offset-slate-950 active:scale-95"
        >
          <svg class="h-6 w-6 text-mint-300 transition group-hover:scale-110" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>
          Call {PHONE_DISPLAY}
        </a>
      </div>

      <p class="animate-fade-in text-sm text-slate-400 delay-300">
        <a href="#services" class="font-semibold text-mint-300 hover:underline">Compare packages</a>
        <span class="mx-2 text-slate-600" aria-hidden="true">·</span>
        <a href="/portfolio" class="font-semibold text-mint-300 hover:underline">See demo sites</a>
      </p>

      <!-- Trust Signal -->
      <div class="pt-8 border-t border-slate-800/50 mt-8">
        <ul class="mb-6 flex flex-wrap justify-center gap-x-8 gap-y-2 text-sm text-slate-300">
          <li>Based in Orange County, NY</li>
          <li>Direct communication with your developer</li>
          <li>Published package pricing</li>
        </ul>
        <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500 mb-3">Built for local businesses like</p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 opacity-60">
          <span class="text-slate-400 font-semibold">HVAC & Contractors</span>
          <span class="text-slate-400 font-semibold">Restaurants & Bars</span>
          <span class="text-slate-400 font-semibold">Auto Services</span>
          <span class="text-slate-400 font-semibold">Retail & Clinics</span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .delay-100 {
    animation-delay: 0.1s;
  }
  .delay-200 {
    animation-delay: 0.2s;
  }
  .delay-300 {
    animation-delay: 0.3s;
  }
</style>
