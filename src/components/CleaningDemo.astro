---
// CleaningDemo.astro - Starter package demo: a one-page site with business details, services,
// click-to-call, social links, and a basic contact form. No booking (that's a Starter add-on).
import { DEMO_PHONE_DISPLAY, DEMO_PHONE_HREF } from '../data/demos';

const services = [
  { name: 'Apartment Clean', price: '$129', detail: 'Studio to 2-bedroom refresh' },
  { name: 'Standard Home', price: '$189', detail: '3-bedroom home with kitchen and bath focus' },
  { name: 'Move-In / Move-Out', price: '$279', detail: 'Top-to-bottom reset for an empty home' },
];
const details = [
  { label: 'Service area', value: 'Middletown, Goshen & nearby towns' },
  { label: 'Hours', value: 'Mon–Sat, 8am–6pm' },
  { label: 'Phone', value: DEMO_PHONE_DISPLAY },
  { label: 'Email', value: 'hello@example.com' },
];
const socials = ['Facebook', 'Instagram'];
const button =
  'inline-flex items-center justify-center rounded-full px-7 py-3 text-sm font-semibold transition focus:outline-none focus-visible:ring-2 focus-visible:ring-emerald-600 focus-visible:ring-offset-2 focus-visible:ring-offset-emerald-50';
const field =
  'w-full rounded-xl border border-emerald-200 bg-white px-4 py-3 text-emerald-950 placeholder-emerald-800/50 focus:border-emerald-600 focus:outline-none focus:ring-2 focus:ring-emerald-600/30';
---

<div class="min-h-screen bg-emerald-50 text-emerald-950">
  <header class="border-b border-emerald-200/80 bg-white/90">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-4 px-6 py-5 lg:px-8">
      <p class="text-lg font-semibold tracking-[0.2em] text-emerald-800">EXAMPLE CLEANING CO.</p>
      <nav aria-label="Page sections" class="hidden items-center gap-8 text-sm font-medium text-emerald-800 md:flex">
        <a href="#services" class="hover:text-emerald-600">Services</a>
        <a href="#details" class="hover:text-emerald-600">Hours &amp; Area</a>
        <a href="#contact" class="hover:text-emerald-600">Contact</a>
      </nav>
      <a href={DEMO_PHONE_HREF} class={`${button} bg-emerald-700 text-white hover:bg-emerald-800`}>Call {DEMO_PHONE_DISPLAY}</a>
    </div>
  </header>

  <main>
    <section class="mx-auto max-w-6xl px-6 py-16 lg:px-8 lg:py-24">
      <h1 class="max-w-3xl text-4xl font-black leading-tight tracking-tight sm:text-5xl">
        House &amp; apartment cleaning in Middletown, NY
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-emerald-900/80">
        Recurring and one-time cleaning for homes and apartments. Call or send a message for a free quote.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href={DEMO_PHONE_HREF} class={`${button} bg-emerald-700 text-white hover:bg-emerald-800`}>Call for a Free Quote</a>
        <a href="#contact" class={`${button} border border-emerald-300 bg-white text-emerald-800 hover:border-emerald-500`}>Send a Message</a>
      </div>
    </section>

    <section id="services" class="mx-auto max-w-6xl px-6 pb-16 lg:px-8">
      <h2 class="text-3xl font-semibold">Services</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-3">
        {services.map((item) => (
          <div class="rounded-2xl border border-emerald-200 bg-white p-6">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-emerald-700">{item.name}</p>
            <p class="mt-3 text-3xl font-black">{item.price}</p>
            <p class="mt-2 text-sm leading-6 text-emerald-900/80">{item.detail}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto grid max-w-6xl gap-8 px-6 pb-20 lg:grid-cols-2 lg:px-8">
      <div id="details" class="rounded-2xl border border-emerald-200 bg-white p-6 sm:p-8">
        <h2 class="text-2xl font-semibold">Hours &amp; service area</h2>
        <dl class="mt-5 space-y-4">
          {details.map((d) => (
            <div>
              <dt class="text-sm font-semibold text-emerald-700">{d.label}</dt>
              <dd class="text-emerald-950">{d.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <form id="contact" data-demo-form="Demo only: in a real Starter site, this message would go straight to the owner's email." class="rounded-2xl border border-emerald-200 bg-white p-6 sm:p-8">
        <h2 class="text-2xl font-semibold">Send a message</h2>
        <div class="mt-5 space-y-4">
          <label class="block text-sm font-semibold text-emerald-800">Name
            <input required name="name" autocomplete="off" class={`mt-1 ${field}`} />
          </label>
          <label class="block text-sm font-semibold text-emerald-800">Phone or email
            <input required name="contact" autocomplete="off" class={`mt-1 ${field}`} />
          </label>
          <label class="block text-sm font-semibold text-emerald-800">What do you need cleaned?
            <textarea required name="message" rows="3" class={`mt-1 ${field}`}></textarea>
          </label>
          <button type="submit" class={`${button} w-full bg-emerald-700 text-white hover:bg-emerald-800`}>Send Message</button>
          <p data-demo-status role="status" class="text-sm font-semibold text-emerald-800"></p>
        </div>
      </form>
    </section>
  </main>

  <footer class="border-t border-emerald-200 bg-white">
    <div class="mx-auto flex max-w-6xl flex-col gap-4 px-6 py-8 text-sm text-emerald-900/80 sm:flex-row sm:items-center sm:justify-between lg:px-8">
      <p>Example Cleaning Co. · Middletown, NY</p>
      <ul class="flex gap-4" aria-label="Social profiles">
        {socials.map((name) => (
          <li><a href="#" class="font-semibold text-emerald-800 underline-offset-2 hover:underline">{name}</a></li>
        ))}
      </ul>
    </div>
  </footer>
</div>
