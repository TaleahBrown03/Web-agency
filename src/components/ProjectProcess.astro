---
// ProjectProcess.astro - Four-step project workflow, from first contact through launch.
const steps = [
  {
    title: 'Tell us about your business',
    description:
      'Share what you do, who you serve, and what you want your website to accomplish. A consultation is a chance to discuss your goals and possible features.',
  },
  {
    title: 'Choose a direction',
    description:
      "We'll review the website tier that may fit, the features you need, and an estimated price range. Custom requests are scoped separately before a final quote.",
  },
  {
    title: 'Design, build, and review',
    description:
      'Your website is created to fit the agreed scope. You review it and provide feedback within the revisions included in your package.',
  },
  {
    title: 'Launch and support',
    description:
      'After approval, your website goes live. Any included post-launch support and optional monthly care plan are explained in your proposal.',
  },
];
---

<section id="how-it-works" class="relative scroll-mt-24 py-16 sm:py-24" aria-labelledby="how-it-works-heading">
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-2xl text-center">
      <p class="text-sm font-semibold uppercase tracking-[0.28em] text-mint-300">Our process</p>
      <h2 id="how-it-works-heading" class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">How a Project Works</h2>
      <p class="mt-4 text-lg leading-relaxed text-slate-300">What happens from first contact through launch.</p>
    </div>

    <ol class="relative mt-12 grid gap-8 lg:grid-cols-4 lg:gap-6">
      <!-- Connector: vertical on mobile, horizontal through the step numbers on desktop -->
      <span class="absolute bottom-5 left-5 top-5 w-px bg-gradient-to-b from-teal-400/60 via-navy-400/50 to-mint-400/60 lg:hidden" aria-hidden="true"></span>
      <span class="absolute left-[12.5%] right-[12.5%] top-5 hidden h-px bg-gradient-to-r from-teal-400/60 via-navy-400/50 to-mint-400/60 lg:block" aria-hidden="true"></span>

      {steps.map((step, index) => (
        <li class="relative flex gap-4 lg:flex-col lg:items-center lg:gap-5">
          <span
            class="relative z-10 flex h-10 w-10 flex-shrink-0 items-center justify-center rounded-full bg-teal-300 text-base font-bold text-slate-950 ring-4 ring-slate-950"
            aria-hidden="true"
          >
            {index + 1}
          </span>
          <div class="flex-1 rounded-xl border border-teal-400/25 bg-slate-900/60 p-5 lg:w-full lg:p-6">
            <h3 class="text-lg font-bold text-slate-50">
              <span class="sr-only">Step {index + 1}: </span>{step.title}
            </h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-300">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="mt-12 text-center">
      <a
        href="/contact#contact"
        class="inline-flex items-center justify-center gap-2 rounded-xl bg-gradient-to-r from-mint-400 to-teal-400 px-8 py-4 text-lg font-bold text-slate-950 shadow-lg shadow-teal-500/20 transition hover:shadow-teal-500/40 focus:outline-none focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
      >
        Start with a free consultation <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>
