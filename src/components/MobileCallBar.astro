---
import { PHONE_DISPLAY, PHONE_HREF } from '../data/pricing';
---

<div
  class="fixed inset-x-0 bottom-0 z-40 grid grid-cols-2 gap-2 border-t border-slate-800 bg-slate-950/95 p-3 backdrop-blur-lg md:hidden"
  style="padding-bottom: max(0.75rem, env(safe-area-inset-bottom));"
>
  <a
    href={PHONE_HREF}
    class="inline-flex items-center justify-center gap-1.5 rounded-xl border-2 border-mint-500/70 bg-slate-900/80 px-2 py-3 text-[13px] font-bold text-slate-50 active:scale-95 min-[380px]:text-sm"
    aria-label={`Call ${PHONE_DISPLAY}`}
  >
    <svg class="h-4 w-4 flex-shrink-0 text-mint-300" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
    </svg>
    <span class="whitespace-nowrap">{PHONE_DISPLAY}</span>
  </a>
  <a
    href="/contact"
    class="inline-flex items-center justify-center gap-1.5 rounded-xl bg-gradient-to-r from-mint-500 to-teal-500 px-2 py-3 text-sm font-bold text-slate-950 shadow-lg shadow-mint-500/30 active:scale-95"
  >
    <svg class="h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
    </svg>
    <span class="whitespace-nowrap">Free Consult</span>
  </a>
</div>
