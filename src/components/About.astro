---
// About.astro - Company overview: who we help, what we build, and how working together goes
const industries = ['HVAC & contractors', 'Landscapers & handymen', 'Barbers & solo operators', 'Restaurants & bars', 'Auto services', 'Retail & clinics'];
const offerings = ['Custom-coded websites', 'Local SEO setup', 'Online booking', 'E-commerce', 'Brand-aligned design', 'Monthly care plans'];
---

<section id="about" class="relative py-24 sm:py-32">
  <div class="mx-auto max-w-5xl px-4 sm:px-6 lg:px-8">
    <div class="grid gap-10 lg:grid-cols-[0.55fr_0.45fr] lg:items-start">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.28em] text-mint-400">About Orange County Webworks</p>
        <h2 class="mt-3 text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl">
          Websites for local businesses in Orange County, NY
        </h2>
        <p class="mt-5 text-lg leading-8 text-slate-300">
          Orange County Webworks builds fast, custom-coded websites for small businesses across Middletown, Newburgh, Warwick, and the rest of Orange County. Every site is built around the business it's for, with no templates, and set up to be found in local search.
        </p>
        <p class="mt-4 text-lg leading-8 text-slate-300">
          You get one point of contact from start to finish, published price ranges before you reach out, and a full review before anything goes live.
        </p>
      </div>

      <div class="space-y-6">
        <div class="rounded-xl border border-slate-700/60 bg-slate-900/50 p-6">
          <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-300">Who we work with</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {industries.map((item) => (
              <li class="rounded-full border border-slate-700 bg-slate-950/60 px-3 py-1.5 text-sm text-slate-200">{item}</li>
            ))}
          </ul>
        </div>
        <div class="rounded-xl border border-slate-700/60 bg-slate-900/50 p-6">
          <h3 class="text-sm font-semibold uppercase tracking-[0.2em] text-slate-300">What we build</h3>
          <ul class="mt-4 flex flex-wrap gap-2">
            {offerings.map((item) => (
              <li class="rounded-full border border-mint-400/30 bg-mint-500/10 px-3 py-1.5 text-sm text-mint-100">{item}</li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
