---
// ContactForm.astro - Premium Two-Column Contact & Consultation Booking System
// Left Column: Operational Contact Form with Service Tiers
// Right Column: Live Calendar Scheduling Interface
import { PRICING_TIERS, PHONE_DISPLAY, PHONE_HREF, BOOKING_URL } from '../data/pricing';
---

<section id="contact" class="relative py-24 sm:py-40">
  <!-- Background gradients -->
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div class="absolute -top-64 right-1/4 h-96 w-96 rounded-full bg-mint-500/5 blur-3xl" aria-hidden="true"></div>
    <div class="absolute -bottom-64 left-1/3 h-96 w-96 rounded-full bg-teal-500/5 blur-3xl" aria-hidden="true"></div>
  </div>

  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <!-- Section Header -->
    <div class="mb-16 space-y-6 text-center">
      <h2 class="text-4xl font-bold text-slate-50 sm:text-6xl">Let's Build Your Growth Engine</h2>
      <p class="text-lg text-slate-400 max-w-2xl mx-auto">Choose your preferred way to connect: submit your project details or lock in a discovery call directly on our calendar.</p>
    </div>

    <!-- Two-Column Layout: Form + Calendar Booking -->
    <div class="grid gap-8 lg:grid-cols-2">
      
      <!-- LEFT COLUMN: Contact Form -->
      <div class="flex flex-col">
        <!-- Quick Call CTA -->
        <div class="mb-8 rounded-2xl border border-mint-500/30 bg-mint-500/5 p-6">
          <p class="text-sm font-semibold text-mint-300 mb-2">
            PREFER TO TALK RIGHT NOW?
          </p>
          <a
            href={PHONE_HREF}
            class="inline-flex items-center gap-2 rounded-xl bg-gradient-to-r from-mint-500 to-teal-500 px-5 py-3 text-xl font-bold text-slate-950 shadow-lg shadow-mint-500/30 transition hover:shadow-mint-500/50 focus:outline-none focus:ring-2 focus:ring-mint-400 focus:ring-offset-2 focus:ring-offset-slate-950 active:scale-95 sm:text-2xl"
          >
            <svg class="h-5 w-5 flex-shrink-0" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            Call {PHONE_DISPLAY}
          </a>
          <p class="mt-3 text-sm text-slate-400">
            Call for a free consultation. We respond to messages within 24 hours.
          </p>
        </div>

        <!-- Contact Form Container -->
        <div class="rounded-2xl border border-slate-700/50 bg-gradient-to-br from-slate-900/50 to-slate-800/30 p-5 sm:p-8 backdrop-blur-sm flex-1 flex flex-col">
          <h3 class="text-2xl font-bold text-slate-50 mb-6">Send Your Project Details</h3>

          <div id="formSuccess" class="hidden flex-1 flex-col items-center justify-center text-center py-12">
            <svg class="h-14 w-14 text-mint-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12.75L11.25 15 15 9.75M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            <h4 class="mt-4 text-xl font-bold text-slate-50">Thanks — got your project details.</h4>
            <p class="mt-2 text-slate-400">We'll respond within 24 hours.</p>
          </div>

          <form id="contactForm" class="space-y-5 flex-1 flex flex-col" action="https://formspree.io/f/xgogwzyg" method="POST">
            
            <!-- Your Name Field -->
            <div>
              <label for="visitor_name" class="block text-sm font-semibold text-slate-300 mb-2">
                Your Name <span class="text-mint-400">*</span>
              </label>
              <input
                type="text"
                id="visitor_name"
                name="visitor_name"
                required
                placeholder="John Smith"
                class="w-full rounded-lg border border-slate-600/50 bg-slate-900/50 px-4 py-2.5 text-slate-100 placeholder-slate-600 transition focus:border-mint-400 focus:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-mint-400/30 hover:border-slate-500"
              />
            </div>

            <!-- Business Email Field -->
            <div>
              <label for="email" class="block text-sm font-semibold text-slate-300 mb-2">
                Business Email <span class="text-mint-400">*</span>
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="hello@yourbusiness.com"
                class="w-full rounded-lg border border-slate-600/50 bg-slate-900/50 px-4 py-2.5 text-slate-100 placeholder-slate-600 transition focus:border-mint-400 focus:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-mint-400/30 hover:border-slate-500"
              />
            </div>

            <!-- Business Name Field -->
            <div>
              <label for="business_name" class="block text-sm font-semibold text-slate-300 mb-2">
                Business Name <span class="text-mint-400">*</span>
              </label>
              <input
                type="text"
                id="business_name"
                name="business_name"
                required
                placeholder="Your Business LLC"
                class="w-full rounded-lg border border-slate-600/50 bg-slate-900/50 px-4 py-2.5 text-slate-100 placeholder-slate-600 transition focus:border-mint-400 focus:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-mint-400/30 hover:border-slate-500"
              />
            </div>

            <!-- Phone Number Field -->
            <div>
              <label for="phone" class="block text-sm font-semibold text-slate-300 mb-2">
                Phone Number <span class="text-mint-400">*</span>
              </label>
              <input
                type="tel"
                id="phone"
                name="phone"
                required
                placeholder="(845) 555-0123"
                class="w-full rounded-lg border border-slate-600/50 bg-slate-900/50 px-4 py-2.5 text-slate-100 placeholder-slate-600 transition focus:border-mint-400 focus:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-mint-400/30 hover:border-slate-500"
              />
            </div>

            <!-- Service Tier Dropdown -->
            <div>
              <label for="service_tier" class="block text-sm font-semibold text-slate-300 mb-2">
                Which package are you interested in? <span class="text-mint-400">*</span>
              </label>
              <select
                id="service_tier"
                name="service_tier"
                required
                class="w-full rounded-lg border border-slate-600/50 bg-slate-900/50 px-4 py-2.5 text-slate-100 transition focus:border-mint-400 focus:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-mint-400/30 hover:border-slate-500 appearance-none cursor-pointer"
              >
                <option value="">Choose a package...</option>
                {PRICING_TIERS.map((tier) => (
                  <option value={tier.id}>{tier.name}{tier.highlight ? ' (Recommended)' : ''} - {tier.price} one-time</option>
                ))}
                <option value="not-sure">Not sure yet - help me choose</option>
              </select>
            </div>

            <!-- Quote calculator selections (filled in only when arriving from the calculator) -->
            <input type="hidden" name="quote_package" data-quote-field="package" disabled />
            <input type="hidden" name="quote_addons" data-quote-field="addons" disabled />
            <input type="hidden" name="quote_estimate" data-quote-field="estimate" disabled />
            <p id="quoteNotice" hidden class="rounded-lg border border-mint-400/40 bg-mint-500/10 px-4 py-3 text-sm text-mint-100">
              Your quote calculator selections were added to the message below. Add anything else about your project before sending.
            </p>

            <!-- Project Description Textarea -->
            <div class="flex-1 flex flex-col">
              <label for="message" class="block text-sm font-semibold text-slate-300 mb-2">
                Tell us about your project <span class="text-mint-400">*</span>
              </label>
              <textarea
                id="message"
                name="message"
                rows="5"
                required
                placeholder="What services does your business offer? What are your main goals? Any specific features or automations you need?"
                class="w-full min-h-[8rem] flex-1 rounded-lg border border-slate-600/50 bg-slate-900/50 px-4 py-2.5 text-slate-100 placeholder-slate-600 transition focus:border-mint-400 focus:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-mint-400/30 hover:border-slate-500 resize-none"
              ></textarea>
            </div>

            <!-- Submit Button -->
            <button
              type="submit"
              id="contactSubmit"
              class="w-full mt-2 rounded-lg bg-gradient-to-r from-mint-500 to-teal-500 px-6 py-3 text-base font-bold text-slate-950 shadow-lg shadow-mint-500/30 transition duration-300 hover:shadow-xl hover:shadow-mint-500/50 hover:scale-105 focus:outline-none focus:ring-2 focus:ring-mint-400 focus:ring-offset-2 focus:ring-offset-slate-950 active:scale-95 disabled:opacity-60 disabled:hover:scale-100"
            >
              Send Project Details →
            </button>

            <!-- Error Note (shown only if submission fails) -->
            <p id="formError" class="hidden text-xs text-red-400 text-center">
              Something went wrong sending that — please try again or call us directly.
            </p>

            <!-- Privacy Note -->
            <p class="text-xs text-slate-400 text-center">
              Secure submission. We'll respond within 24 hours.
            </p>
          </form>
        </div>
      </div>

      <!-- RIGHT COLUMN: Calendar Scheduling -->
      <div class="flex flex-col">
        <!-- Calendar Header -->
        <div class="mb-8 space-y-3">
          <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-slate-900/40 border border-teal-500/30 w-fit">
            <span class="text-sm font-semibold text-teal-300">SCHEDULE A FREE DISCOVERY CALL</span>
          </div>
          <h3 class="text-2xl font-bold text-slate-50">
            Pick Your Strategy Session
          </h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            Available <span class="font-semibold text-mint-300">Monday through Friday, 8am–5pm</span> for phone or video consultations. Select a time block below to lock in your dedicated strategy session.
          </p>
        </div>

        <!-- Calendar Container: live Cal.com embed -->
        <div class="rounded-2xl border border-slate-700/50 bg-gradient-to-br from-slate-900/50 to-slate-800/30 p-2 backdrop-blur-sm flex-1 flex flex-col overflow-hidden">
          <iframe
            src={`${BOOKING_URL}?theme=dark`}
            class="w-full flex-1 min-h-[600px] rounded-xl bg-slate-900"
            style="border: 0;"
            loading="lazy"
            title="Schedule a discovery call"
          ></iframe>
        </div>
        <p class="mt-4 text-center text-sm text-slate-400">
          Calendar not loading?
          <a
            href={BOOKING_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="font-semibold text-teal-300 hover:underline"
          >Open the booking page in a new tab →</a>
        </p>
      </div>
    </div>

    <!-- Trust Badges Section -->
    <div class="mt-16 grid gap-6 sm:grid-cols-3">
      <div class="flex items-start gap-3 rounded-lg border border-slate-700/30 bg-slate-900/20 p-4">
        <div class="mt-1">
          <svg class="h-5 w-5 text-mint-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-slate-100 text-sm">24-Hour Response</h4>
          <p class="text-xs text-slate-400 mt-1">All inquiries answered within one business day</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-lg border border-slate-700/30 bg-slate-900/20 p-4">
        <div class="mt-1">
          <svg class="h-5 w-5 text-teal-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-slate-100 text-sm">Free Consultation</h4>
          <p class="text-xs text-slate-400 mt-1">No obligation, no upsell — just strategy</p>
        </div>
      </div>

      <div class="flex items-start gap-3 rounded-lg border border-slate-700/30 bg-slate-900/20 p-4">
        <div class="mt-1">
          <svg class="h-5 w-5 text-navy-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
          </svg>
        </div>
        <div>
          <h4 class="font-semibold text-slate-100 text-sm">Your Data is Secure</h4>
          <p class="text-xs text-slate-400 mt-1">Encrypted submissions, never shared or sold</p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { computeQuote, quoteSummaryText, selectionFromParams } from '../lib/quote';

  // Carries quote calculator selections into the form. Only selections travel in the URL;
  // the estimate is recalculated here from the same pricing data so it can't be edited in the link.
  function applyQuoteSelections() {
    const selection = selectionFromParams(new URLSearchParams(window.location.search));
    const message = document.getElementById('message');
    const notice = document.getElementById('quoteNotice');
    if (!selection || !(message instanceof HTMLTextAreaElement) || !notice) return;

    const result = computeQuote(selection);
    const values: Record<string, string> = {
      package: `${result.tier.name} (${result.tier.price})`,
      addons: result.lines.slice(1).map((line) => `${line.label}: ${line.value}`).join('; ') || 'None',
      estimate: result.totalLabel,
    };
    document.querySelectorAll<HTMLInputElement>('[data-quote-field]').forEach((input) => {
      input.value = values[input.dataset.quoteField ?? ''] ?? '';
      input.disabled = false;
    });

    if (message.value.trim() === '') {
      message.value = `${quoteSummaryText(result)}\n\nAbout my project:\n`;
      message.rows = 12;
    }
    notice.hidden = false;
  }

  function preselectTier() {
    const select = document.getElementById('service_tier');
    const tier = new URLSearchParams(window.location.search).get('tier');
    if (!(select instanceof HTMLSelectElement) || !tier) return;
    if (Array.from(select.options).some((option) => option.value === tier)) {
      select.value = tier;
    }
  }

  function initContactForm() {
    preselectTier();
    applyQuoteSelections();
    const form = document.getElementById('contactForm');
    const successBox = document.getElementById('formSuccess');
    const errorNote = document.getElementById('formError');
    const submitButton = document.getElementById('contactSubmit');
    if (!(form instanceof HTMLFormElement) || !successBox || !errorNote || !(submitButton instanceof HTMLButtonElement)) return;

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      errorNote.classList.add('hidden');
      submitButton.disabled = true;
      submitButton.textContent = 'Sending...';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: { Accept: 'application/json' },
        });

        if (response.ok) {
          form.classList.add('hidden');
          successBox.classList.remove('hidden');
          successBox.classList.add('flex');
        } else {
          throw new Error('Form submission failed');
        }
      } catch {
        errorNote.classList.remove('hidden');
        submitButton.disabled = false;
        submitButton.textContent = 'Send Project Details →';
      }
    });
  }

  document.addEventListener('DOMContentLoaded', initContactForm);
  document.addEventListener('astro:after-swap', initContactForm);
</script>
