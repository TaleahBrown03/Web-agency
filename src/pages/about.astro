---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import About from '../components/About.astro';
import ProjectProcess from '../components/ProjectProcess.astro';
import { PHONE_DISPLAY, PHONE_HREF } from '../data/pricing';

const straightforward = [
  'One point of contact: you work with the same contact from the first call through launch, with no hand-offs along the way.',
  'Clear pricing: package price ranges are published on the site, and every project gets a written quote.',
  'A defined process: you know what happens at each step, and you review the site before launch.',
  "Local: we're based in Orange County, NY, and build for businesses in the towns we serve.",
];
---

<Layout title="About | Orange County Webworks" description="Orange County Webworks builds custom-coded websites, local SEO, booking, and e-commerce for small businesses in Orange County, NY. See how a project works.">
  <Navigation />
  <main id="main-content" class="pb-20 md:pb-0">
    <About />

    <ProjectProcess />

    <section class="relative py-16 sm:py-24 border-t border-slate-800/50">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold tracking-tight text-slate-50 sm:text-4xl mb-8 text-center">What Makes It Straightforward</h2>
        <ul class="space-y-4">
          {straightforward.map((reason) => (
            <li class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 flex-shrink-0 text-mint-400" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
              </svg>
              <span class="text-slate-300 leading-relaxed">{reason}</span>
            </li>
          ))}
        </ul>

        <div class="mt-12 flex flex-col gap-4 sm:flex-row sm:justify-center">
          <a
            href="/services/web-design#quote-calculator"
            class="inline-flex items-center justify-center rounded-lg bg-gradient-to-r from-mint-400 to-teal-400 px-8 py-3 font-bold text-slate-950 shadow-lg shadow-mint-500/30 transition hover:shadow-mint-500/50 focus:outline-none focus-visible:ring-2 focus-visible:ring-mint-300 focus-visible:ring-offset-2 focus-visible:ring-offset-slate-950"
          >
            Get an Estimate
          </a>
          <a
            href="/contact#contact"
            class="inline-flex items-center justify-center rounded-lg border-2 border-mint-400/60 px-8 py-3 font-semibold text-mint-200 transition hover:border-mint-300 hover:bg-mint-500/10 focus:outline-none focus-visible:ring-2 focus-visible:ring-mint-400"
          >
            Discuss Your Project
          </a>
          <a
            href={PHONE_HREF}
            class="inline-flex items-center justify-center rounded-lg px-4 py-3 font-semibold text-slate-200 transition hover:text-slate-50 focus:outline-none focus-visible:ring-2 focus-visible:ring-mint-400"
          >
            or call {PHONE_DISPLAY}
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
  <MobileCallBar />
</Layout>
