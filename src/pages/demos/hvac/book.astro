---
import HvacSite from '../../../components/demos/HvacSite.astro';

const days = ['Mon 14', 'Tue 15', 'Wed 16', 'Thu 17'];
const times = ['8:00 AM', '10:00 AM', '1:00 PM', '3:00 PM'];
const chip =
  'cursor-pointer rounded-lg border border-slate-300 bg-white px-4 py-2 text-sm font-semibold text-slate-700 has-[:checked]:border-sky-700 has-[:checked]:bg-sky-50 has-[:checked]:text-sky-900 has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-sky-600';
---

<HvacSite title="Book Online" current="book">
  <h1 class="text-4xl font-black tracking-tight">Book a visit</h1>
  <p class="mt-4 max-w-2xl text-lg text-slate-600">
    Growth includes one standard third-party booking integration. The business's own booking tool is embedded here, so customers can pick a time without calling.
  </p>

  <form data-demo-form="Demo only: in a real site, the business's booking tool confirms the appointment." class="mt-10 max-w-2xl rounded-2xl border-2 border-dashed border-slate-300 bg-white p-6 sm:p-8">
    <p class="text-xs font-semibold uppercase tracking-[0.2em] text-slate-500">Booking tool embed (sample)</p>
    <fieldset class="mt-5">
      <legend class="font-bold">Day</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {days.map((d, i) => <label class={chip}><input type="radio" name="day" value={d} required={i === 0} class="sr-only" />{d}</label>)}
      </div>
    </fieldset>
    <fieldset class="mt-6">
      <legend class="font-bold">Time</legend>
      <div class="mt-3 flex flex-wrap gap-2">
        {times.map((t, i) => <label class={chip}><input type="radio" name="time" value={t} required={i === 0} class="sr-only" />{t}</label>)}
      </div>
    </fieldset>
    <button type="submit" class="mt-8 w-full rounded-full bg-orange-600 px-6 py-3 font-semibold text-white hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2">Confirm Booking</button>
    <p data-demo-status role="status" class="mt-3 text-sm font-semibold text-sky-900"></p>
  </form>
</HvacSite>
