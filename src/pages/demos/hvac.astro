---
import HvacSite from '../../components/demos/HvacSite.astro';
import { DEMO_PHONE_DISPLAY, DEMO_PHONE_HREF } from '../../data/demos';

const services = ['Heating repair', 'AC repair & installation', 'Furnace & boiler service', 'Seasonal maintenance'];
---

<HvacSite title="Home" current="home">
  <section class="grid gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-sky-800">Newburgh, NY heating &amp; cooling</p>
      <h1 class="mt-3 text-4xl font-black leading-tight tracking-tight sm:text-5xl">Heating and AC service when you need it</h1>
      <p class="mt-5 max-w-xl text-lg leading-8 text-slate-600">
        Repairs, installations, and seasonal tune-ups for homes and small businesses. Book a visit online or call to talk to a technician.
      </p>
      <div class="mt-8 flex flex-col gap-3 sm:flex-row">
        <a href="/demos/hvac/book" class="inline-flex justify-center rounded-full bg-orange-600 px-7 py-3 font-semibold text-white hover:bg-orange-700 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2">Book a Visit Online</a>
        <a href={DEMO_PHONE_HREF} class="inline-flex justify-center rounded-full border border-slate-300 bg-white px-7 py-3 font-semibold text-slate-800 hover:border-sky-600 focus:outline-none focus-visible:ring-2 focus-visible:ring-sky-600">Call {DEMO_PHONE_DISPLAY}</a>
      </div>
    </div>
    <div class="rounded-3xl border border-slate-200 bg-white p-8">
      <h2 class="text-xl font-bold">What we work on</h2>
      <ul class="mt-4 space-y-3">
        {services.map((s) => (
          <li class="flex items-center gap-3 text-slate-700"><span class="h-2 w-2 rounded-full bg-sky-700" aria-hidden="true"></span>{s}</li>
        ))}
      </ul>
      <a href="/demos/hvac/services" class="mt-6 inline-block font-semibold text-sky-800 hover:underline">See all services →</a>
    </div>
  </section>
</HvacSite>
